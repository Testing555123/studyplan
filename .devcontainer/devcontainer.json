{
  "name": "StudyPlan (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  // 端口 7860：space 形态单容器（RUNTIME_FLAVOR=space）对外端口；公开可见便于演示。
  // 端口 3000：本地开发模式（pnpm dev）。
  "forwardPorts": [7860, 3000],
  "portsAttributes": {
    "7860": {
      "label": "StudyPlan (space 容器)",
      "visibility": "public",
      "onAutoForward": "openBrowser"
    },
    "3000": {
      "label": "StudyPlan (dev)"
    }
  },
  "customizations": {
    "codespaces": {
      "ports": {
        "7860": {
          "visibility": "public"
        }
      }
    }
  },
  // 创建时：装依赖（本地开发用）+ 构建/启动 space 容器（构建走 Docker 层缓存，重复执行很快）。
  "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile && sh scripts/codespaces-space-run.sh",
  // 每次启动/重启 Codespace：幂等拉起容器并健康检查。
  "postStartCommand": "sh scripts/codespaces-space-run.sh"
}
