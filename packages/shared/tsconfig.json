{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // 输出 CommonJS：NestJS 运行在 CJS 上，Nuxt/Vite 也能正常消费 CJS。
    // 若这里改成 ESM，后端 require 会直接炸掉——这是 monorepo 共享包最容易踩的坑。
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
