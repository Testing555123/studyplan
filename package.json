{
  "name": "studyplan",
  "version": "0.1.0",
  "private": true,
  "description": "学习/技术分享社区 —— 从零到上线的全栈教学项目（Nuxt 4 + NestJS 11 + MongoDB Atlas）",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm run build:shared && pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @studyplan/web dev",
    "dev:api": "pnpm --filter @studyplan/api dev",
    "dev:docs": "pnpm --filter @studyplan/docs dev",
    "build:shared": "pnpm --filter @studyplan/shared build",
    "build": "pnpm run build:shared && pnpm -r build",
    "typecheck": "pnpm run build:shared && pnpm -r typecheck",
    "test": "pnpm -r test",
    "bench:vercel": "node scripts/bench-vercel.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
