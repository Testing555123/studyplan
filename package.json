    "db:reconcile": "node scripts/reconcile-counters.mjs",
    "embed:backfill": "node scripts/embed-backfill.mjs",
    "spike:embed": "node scripts/spike-embed.mjs"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@base-ui/react": "^1.8.0",
    "@huggingface/transformers": "4.3.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.16.2",
    "lucide-react": "^0.552.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "next-safe-action": "^7.10.3",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
