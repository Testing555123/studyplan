# 环境变量模板（复制为 .env 后填写）。
# 本地 PostgreSQL：本仓库 docker-compose 发布到 5433（宿主 5432 常被本机 PG 占用）。
DATABASE_URL=postgresql://studyplan:studyplan@localhost:5433/studyplan

# better-auth：生产必须换成强随机 secret（>=32 字符）
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# AI（可选）：留空则未配 Key，应用照常启动并降级（SPEC §6.4 / V5）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# 托管嵌入/重排模型（T10，可选）：未配置则查询向量化降级（跳过向量检索）
AI_EMBED_MODEL=
AI_RERANK_MODEL=

# 本地模型（Qwen3-Embedding / Qwen3-Reranker ONNX，方案 B：预下载 + 离线加载）
# 缓存目录：权重落地位置，必须与 scripts/download-models.mjs 一致；默认 .model-cache（已 gitignore）。
# 切勿放在 node_modules/ 下（pnpm 会清空，详见 docs/DECISIONS.md D9/D18）。
MODEL_CACHE_DIR=.model-cache
# 预下载时使用的 HuggingFace 镜像；受限网络（huggingface.co 不可达）设为 https://hf-mirror.com。
# 仅影响 pnpm models:download 阶段；运行时离线模式不触碰网络。
HF_ENDPOINT=https://hf-mirror.com
# 离线模式：=1/true 时运行时禁止联网，权重缺失即报错（提示先 pnpm models:download）。
# 生产/容器建议置 1，配合镜像内置或挂载卷的 .model-cache。
LOCAL_MODELS_ONLY=false

# 每日问答额度（T11，默认 300）
AI_DAILY_LIMIT=300

# T13 Agent 的现成网络搜索 tool（可选）：未配置则不注册
TAVILY_API_KEY=
# T13 MCP 适配器（可选）：默认不启用（单容器约束）
MCP_ENDPOINT=
# LangChain 遥测：显式关闭，保证内容不出网
LANGCHAIN_TRACING_V2=false
LANGCHAIN_CALLBACKS_BACKGROUND=false

# T14 Giscus 评论（可选）：四项齐备才渲染（GitHub Discussions，见 SPEC §12.5）
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

NODE_ENV=development
