# ============================================================
#  后端环境变量模板（复制到 apps/api/.env 后填写真实值）
# ------------------------------------------------------------
#  Windows PowerShell:
#    Copy-Item .env.example apps/api/.env
#  macOS / Linux:
#    cp .env.example apps/api/.env
#
#  ❗本文件**只放空值**，真实值绝不进 Git。
#    apps/api/.env 已被 .gitignore 忽略，仓库里只保留这份模板。
#
#  ❗值不要加引号，也不要有空格。
# ============================================================

# ---------- 必填（缺失时进程启动即失败）----------

# MongoDB 连接串（Atlas 或自建都行）。
# 密码含 @ : / ? 等字符时必须做 URL 编码（@ → %40）。
# 末尾要带上库名，例如 /studyplan
MONGODB_URI=

# Access Token 签名密钥，至少 32 字符。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# Refresh Token 签名密钥，至少 32 字符，**必须与上面那个不同**。
# 两者分开的意义：Access Token 泄露无法当 Refresh Token 用。
JWT_REFRESH_SECRET=

# ---------- 可选（有默认值，本地开发通常不用改）----------

# 运行环境。决定 Refresh Cookie 的 secure 属性：
#   production → secure=true（必须走 HTTPS）
#   其他       → secure=false（本地 http 才能用）
# 允许值：development / production / test
NODE_ENV=development

# 后端监听端口
PORT=3000

# 允许的前端来源（多个用逗号分隔）。
# 本地是 http://localhost:3001；生产填真实站点地址。
CORS_ORIGIN=http://localhost:3001

# Refresh Cookie 的 SameSite 属性。
# 同域部署保持 lax；只有前后端跨站时才需要 none（且必须同时满足 HTTPS + NODE_ENV=production）
COOKIE_SAME_SITE=lax

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- AI 学习助手（NVIDIA NIM，全部可留空）----------
# ⚠️ 全部可留空：AI 是**增强功能**，不配也能跑 ——
#    应用正常启动，AI 接口返回「未启用」，发帖等核心链路完全不受影响。
#
# Key 获取：https://build.nvidia.com → 打开任意模型页 → Get API Key
NVNIM_API_KEY=

# 模型名。⚠️ 必须可配，绝不能写死：NIM 的模型会下线。
# 实测 meta/llama-3.1-8b-instruct、nemotron-3-nano-30b-a3b、
# llama-3.3-70b-instruct 均返回 410 Gone，写死模型名迟早全线报错。
#
# ⚠️ 另一个坑：**名字带 "flash" 不代表快**。deepseek-v4-flash-0731 是
#    推理模型，思考链占掉一半以上输出，简单问题 22 秒、复杂问题直接超时。
#    目前默认的 gpt-oss-20b 实测约 36 字/秒，是候选里产出最快的。
# 可用清单随时查：GET https://integrate.api.nvidia.com/v1/models
NVNIM_MODEL=openai/gpt-oss-20b

# 单次调用超时（毫秒），范围 1000 ~ 60000
NVNIM_TIMEOUT_MS=25000

# 每日调用上限（命中缓存的提问不计数）。
# AI 对所有人开放，而 NIM 免费额度有限，这道闸防止链接被分享后额度被刷爆。
NVNIM_DAILY_LIMIT=300

# ---------- GitHub 热门项目榜（可留空）----------
# ⚠️ 留空也能正常工作。注意这个 Token 对限流的提升**远不如想象中大**：
#    Search API 是独立限流 —— 未认证 10 次/分钟，认证后也只有 30 次/分钟，
#    而不是 core 接口那种 5000 次/小时。真正保证不撞限流的是服务端缓存。
# 权限只需能读公开仓库即可。
GITHUB_TOKEN=

# 榜单缓存软过期时长（分钟），范围 5 ~ 10080（7 天）
GITHUB_TRENDING_CACHE_TTL_MINUTES=360

# ---------- 每日 GitHub 项目报道（全部可留空，默认关闭）----------
# ⚠️ 总开关默认 false。这个装置会**以机器人身份真实发帖**，
#    发出来的内容所有用户都能看到，所以确认要开启之前请保持关闭。
#
# 开启需要两步，缺一不可 —— 这是两把独立的锁：
#   1. DAILY_DIGEST_ENABLED=true
#   2. DAILY_DIGEST_CRON_TOKEN 填一个随机串
#
# 用 Vercel Cron 时的完整步骤：
#   a) 在 Vercel 项目里设置环境变量 CRON_SECRET（随机串）；
#   b) 把 DAILY_DIGEST_CRON_TOKEN 设成与 CRON_SECRET **相同的值** ——
#      Vercel 触发 Cron 时会以 `Authorization: Bearer <CRON_SECRET>` 发过来，
#      后端同时认这个标准头和自定义头 `x-daily-token`；
#   c) 重新部署（环境变量与 vercel.json 的 crons 都要新部署才生效）。
#
# 没配 Cron 也能工作：页面访问「GitHub 热门项目」时会惰性补发当天那篇。
# 想确认到底有没有生效，直接看那个页面顶部的「每日 GitHub 项目报道」区块 ——
# 它会明确显示"未启用 / 未配定时令牌 / 今天还没生成"。
DAILY_DIGEST_ENABLED=false
DAILY_DIGEST_CRON_TOKEN=

# 计算"今天"用的时区（IANA 时区名）。
# 用它而不是 UTC，是为了让"每天一篇"符合人的直觉 ——
# 否则北京时间早上发的那篇会被记成前一天，当天再触发就被判成已发过。
DAILY_DIGEST_TIMEZONE=Asia/Shanghai

# 一天中从第几个小时起允许发布（0-23）。
# 它约束的是惰性触发，避免凌晨有人访问一次就把当天那篇在半夜发掉。
DAILY_DIGEST_PUBLISH_HOUR=9

# 候选项目的最小 star 数
DAILY_DIGEST_MIN_STARS=50

# 只看最近多少天内新建的仓库
DAILY_DIGEST_LOOKBACK_DAYS=30

# 语言白名单，逗号分隔。**留空 = 不限语言**
# 只想推前端项目就填：TypeScript,JavaScript,Vue
DAILY_DIGEST_LANGUAGES=

# 从候选池里最多考虑前几个项目（榜单最多返回 100 条）
DAILY_DIGEST_CANDIDATE_LIMIT=100

# 报道的 AI 输出上限与超时。
# 比问答场景（800 token / 25 秒）宽松，因为报道跑在后台、没有用户盯着等。
DAILY_DIGEST_AI_MAX_TOKENS=2000
DAILY_DIGEST_AI_TIMEOUT_MS=40000

# 是否允许"读取接口顺带补发"。配好 Cron 之后可以设成 false。
DAILY_DIGEST_LAZY_TRIGGER=true

# 机器人账号的用户名，会成为报道帖子上显示的作者名。
# 改它等于换一个作者身份，之前的报道仍挂在旧账号名下 —— 上线后不要随意改。
DAILY_DIGEST_BOT_USERNAME=github-daily

# ---------- 项目简介的 AI 润色（全部可留空，默认开启）----------
# 把 GitHub 官方的英文简介改写成一段通顺的中文，显示在榜单卡片与仓库详情页。
# 额度**复用**问答的 NVNIM_DAILY_LIMIT，缓存命中不计费。
#
# 关掉后只是不再生成新简介，已有的照常返回。
GITHUB_INTRO_ENABLED=true

# 单次调用最多生成几条 / 时间预算多少毫秒。
# 这两项一起决定"一次请求最坏挂多久"——生成一条实测 20-40 秒，
# 调大会让请求撞上平台执行时长上限，反而一条都拿不到。
GITHUB_INTRO_BATCH_LIMIT=3
GITHUB_INTRO_TIME_BUDGET_MS=20000

# 单条简介的输出上限与超时
GITHUB_INTRO_AI_MAX_TOKENS=300
GITHUB_INTRO_AI_TIMEOUT_MS=20000

# 简介有效期（天）。到期后重新生成，用于兜住"作者改了官方简介"的情况。
GITHUB_INTRO_TTL_DAYS=30
