# ============================================================
#  环境变量模板
# ------------------------------------------------------------
#  用法：复制本文件为 apps/api/.env，再填入真实值。
#        后端启动时会自动读取 apps/api/.env。
#
#  ⚠️  只有本文件（.env.example）可以提交到 Git。
#      填写过真实密钥的 .env 已被 .gitignore 忽略，永远不要提交。
# ============================================================

# ---------- 服务 ----------
# 后端监听端口（前端跑在 3001，文档站跑在 3002，避免端口打架）
PORT=3000
# 允许跨域访问后端的前端地址（多个用英文逗号分隔）
CORS_ORIGIN=http://localhost:3001

# ---------- MongoDB Atlas ----------
# 形如：mongodb+srv://<用户名>:<密码>@<集群地址>.mongodb.net/studyplan?retryWrites=true&w=majority
MONGODB_URI=

# ---------- JWT 双 Token ----------
# 生成方式（PowerShell / bash 均可）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 两个密钥必须不同，且绝不能提交到 Git。
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access Token 有效期：短，泄漏风险小
JWT_ACCESS_EXPIRES_IN=15m
# Refresh Token 有效期：长，可换取新的 Access Token
JWT_REFRESH_EXPIRES_IN=7d

# ---------- 智谱 GLM（LangChain）----------
# 申请地址：https://open.bigmodel.cn
ZHIPUAI_API_KEY=
# 可选值见 https://open.bigmodel.cn/dev/howuse/model
ZHIPUAI_MODEL=glm-4-flash
# AI 单次调用超时（毫秒）——超时即降级，不阻塞发帖
ZHIPUAI_TIMEOUT_MS=15000
