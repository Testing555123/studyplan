# 环境变量模板（复制为 .env 后填写）。compose 会自动读取本文件。
# 本地 PostgreSQL：本仓库 docker-compose 发布到 5433（宿主 5432 常被本机 PG 占用）。
DATABASE_URL=postgresql://studyplan:studyplan@localhost:5433/studyplan

# ===== 生产（OCI / 任意自管 Docker）需补充 =====
# 对外域名（Caddy 自动签发 Let's Encrypt 证书；同时用于 BETTER_AUTH_URL）。
APP_DOMAIN=example.com
# Let's Encrypt 注册邮箱（Caddy 申请证书需要）。
ACME_EMAIL=admin@example.com

# better-auth：生产必须换成强随机 secret（>=32 字符）。缺失/过短会导致容器启动失败（fail-fast）。
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# 生产由 Caddy 提供 https，此处仅作模板；compose 会以 https://${APP_DOMAIN} 覆盖注入。
BETTER_AUTH_URL=http://localhost:3000

# AI（可选）：留空则未配 Key，应用照常启动并降级（SPEC §6.4 / V5）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# 托管嵌入/重排模型（T10，可选）：未配置则查询向量化降级（跳过向量检索）
AI_EMBED_MODEL=
AI_RERANK_MODEL=

# 本地模型（Qwen3-Embedding / Qwen3-Reranker ONNX，方案 B：预下载 + 离线加载）
# 缓存目录：权重落地位置，必须与 scripts/download-models.mjs 一致；默认 .model-cache（已 gitignore）。
MODEL_CACHE_DIR=.model-cache
# 预下载时使用的 HuggingFace 镜像；受限网络（huggingface.co 不可达）设为 https://hf-mirror.com。
HF_ENDPOINT=https://hf-mirror.com
# 离线模式：=1/true 时运行时禁止联网，权重缺失即报错（提示先 pnpm models:download）。
# 生产采用「烘焙进镜像」：MODELS_PRELOAD=1（docker build 期下载进镜像）+ LOCAL_MODELS_ONLY=1（运行时离线）。
LOCAL_MODELS_ONLY=false
# 构建期是否将本地模型烘焙进镜像（仅生产/离线部署置 1；本地开发置 0 以加快构建）。
MODELS_PRELOAD=0

# 每日问答额度（T11，默认 300）
AI_DAILY_LIMIT=300

# GitHub 热门 /trending（可选）：用官方 Search API 按日抓取（每日 1 次调用）。
# 未配置则 /trending 显示「配置提示」空态，页面其余部分照常可用；认证后限额 5000 次/时，绰绰有余。
# 建议用 fine-grained PAT（无需任何权限 / 只读 public data 即可）。
GITHUB_TOKEN=
# 每天抓取的仓库条数（默认 30）。
GITHUB_TRENDING_PER_PAGE=30
# 快照保留天数（默认 7，刷新成功后顺手清理更旧的行）。
GITHUB_TRENDING_KEEP_DAYS=7

# RAG 检索质量闸门阈值（默认 0.35）：top1 相似度低于该值即视为资料不足，
# chat 模式自动转投 agent loop（Tavily 网搜兜底，未配 Key 则退化为站内工具）。
RAG_FALLBACK_SCORE=0.35

# T13 Agent 的现成网络搜索 tool（可选）：未配置则不注册
TAVILY_API_KEY=
# T13 MCP 适配器（可选）：默认不启用（单容器约束）
MCP_ENDPOINT=
# LangChain 遥测：显式关闭，保证内容不出网
LANGCHAIN_TRACING_V2=false
LANGCHAIN_CALLBACKS_BACKGROUND=false

# ===== HF Spaces 单容器形态（RUNTIME_FLAVOR=space，见 docs/deploy/huggingface-spaces.md）=====
# 对外端口：Space Docker SDK 固定探测 7860（本地 compose 形态为 3000，无需设置）。
APP_PORT=7860
# 同机 Postgres：容器内 127.0.0.1:5432，数据目录落在容器内（临时，靠备份闭环）。
PGDATA=/app/data/pg
PGUSER=studyplan
PGDATABASE=studyplan
# 备份闭环（GitHub 私有仓库 Contents API，免费且无需银行卡）。
BACKUP_GITHUB_REPO=
BACKUP_GITHUB_TOKEN=
BACKUP_GITHUB_BRANCH=main
BACKUP_DIR=backups
# 备份间隔（分钟）与保留份数。
BACKUP_INTERVAL_MIN=30
BACKUP_KEEP=24
# =1 时备份/恢复失败即非零退出；默认 0（降级继续，保证服务可用）。
BACKUP_STRICT=0

# T14 Giscus 评论（可选）：四项齐备才渲染（GitHub Discussions，见 SPEC §12.5）
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

NODE_ENV=development
